// todo.hop — multiplayer todos on the durable store.
//
//   cargo run -p hoprt --bin hopd -- hoprt/hop/todo.hop
//   open http://localhost:9000 in two tabs — they stay in sync.
//   restart hopd: the JSONL tape restores the board.

server let schema = store.record([
  ["todos", store.map(store.record([
    ["text", store.leaf],
    ["done", store.leaf]
  ]))],
  ["stats", store.record([
    ["created", store.sum],
    ["completed", store.sum]
  ])]
]);

fn reduce(tx, event) {
  if event.type == "add" {
    tx.put(["todos", tx.seq], { text = event.text, done = false });
    tx.add(["stats", "created"], 1);
  } else {
    if event.type == "toggle" {
      let done = tx.peek(["todos", event.id, "done"]);
      tx.put(["todos", event.id, "done"], !done);
      if done {
        tx.add(["stats", "completed"], -1);
      } else {
        tx.add(["stats", "completed"], 1);
      }
    }
  }
}

fn todo_view(items) {
  let rows = [];
  for i, item in items {
    let id = item.id;
    push(rows, [:li, {
      class = item.done && "done",
      onclick = fn(e) {
        server!();
        store.append({ type = "toggle", id = id });
        let snapshot = store.items(["todos"]);
        let created = store.one(["stats", "created"]);
        let completed = store.one(["stats", "completed"]);
        cast browsers {
          hui.render("#app", todo_app(snapshot, created, completed));
        }
      }
    }, item.text]);
  }
  return [:ul, { id = "todos" }, rows];
}

fn todo_app(items, created, completed) {
  return [:div, {},
    [:h1, {}, "todos"],
    [:p, { class = "meta", id = "stats" }, "" .. completed .. " done of " .. created],
    [:div, { class = "row" },
      [:input, { id = "draft", placeholder = "what needs doing?" }],
      [:button, { id = "add", onclick = fn(e) { add_from_form(); } }, "add"]
    ],
    todo_view(items)
  ];
}

fn add_from_form() {
  let text = dom.get("#draft");
  if text != "" {
    add_todo(text);
  }
}

fn add_todo(text) {
  server!();
  store.append({ type = "add", text = text });
  let snapshot = store.items(["todos"]);
  let created = store.one(["stats", "created"]);
  let completed = store.one(["stats", "completed"]);
  cast browsers {
    hui.render("#app", todo_app(snapshot, created, completed));
  }
}

fn on_connect(sid) {
  let snapshot = store.items(["todos"]);
  let created = store.one(["stats", "created"]);
  let completed = store.one(["stats", "completed"]);
  if !created {
    created = 0;
  }
  if !completed {
    completed = 0;
  }
  cast session(sid) {
    hui.render("#app", todo_app(snapshot, created, completed));
  }
}

fn sim_demo() {
  spawn add_todo("buy milk");
  spawn add_todo("write the compiler");
}
