// todo.hop — a multiplayer todo app: hiccup UI, no HTML strings.
//
//   cargo run -p hoprt --bin hopd -- hoprt/hop/todo.hop
//   open http://localhost:9000 in two tabs — they stay in sync.
//
// The view is data. The click handler is a real closure sitting in an
// attribute — it captures the loop variable `i` lexically (it never
// crosses the wire), and its body hops: mutate on the server, broadcast
// the new state to every tab.

server let todos = [];

fn todo_view(items) {
  let rows = [];
  for i, item in items {
    table.insert(rows, [:li, {
      class = item.done && "done",
      onclick = fn(e) {
        server!();                              // ships {i}
        todos[i].done = !todos[i].done;
        let snapshot = todos;
        cast browsers {
          hui.render("#todos", todo_view(snapshot));
        }
      }
    }, item.text]);
  }
  return [:ul, {}, rows];
}

fn add_todo(text) {
  server!();                                    // ships {text}
  table.insert(todos, { text = text, done = false });
  let snapshot = todos;
  cast browsers {
    hui.render("#todos", todo_view(snapshot));
  }
}

// hopd invokes this when a tab connects: bring the newcomer up to date.
fn on_connect(sid) {
  let snapshot = todos;
  cast session(sid) {
    hui.render("#todos", todo_view(snapshot));
  }
}

// Entry for the simulated-cluster test (each spawn = one DOM event).
fn sim_demo() {
  spawn add_todo("buy milk");
  spawn add_todo("write the compiler");
}
