// todo.hop — multiplayer todos on the durable store.
//
// One panel per tab, woken by the store: writers append and return, the
// panel wakes itself. No push-snapshot, no per-write broadcast.
//
//   wasm-pack build hop-web --target web   (once; the browser interpreter)
//   cargo run -p hoprt --bin hopd -- hoprt/hop/todo.hop
//   open http://localhost:9000 in two tabs — they stay in sync.
//   restart hopd: the JSONL tape restores the board.

schema {
  todos: map<int, record {
    text: leaf,
    done: leaf
  }>,
  stats: record {
    created: sum,
    completed: sum
  }
}

fn reduce(event) {
  match event {
    add { seq, text } => {
      store(["todos", seq, store.set({ text = text, done = false })]);
      store(["stats", "created", store.add(1)]);
    }
    toggle { id } => {
      let done = store(["todos", id, "done"]);
      store(["todos", id, "done", store.set(!done)]);
      if done {
        store(["stats", "completed", store.add(-1)]);
      } else {
        store(["stats", "completed", store.add(1)]);
      }
    }
  }
}

fn todo_view(items) {
  let rows = [];
  for i, item in items {
    let id = item.id;
    push(rows, [:li, {
      class = item.done && "done",
      onclick = fn(e) { toggle_todo(id); }
    }, item.text]);
  }
  return [:ul, { id = "todos" }, rows];
}

fn todo_app(items, created, completed) {
  return [:div, {},
    [:h1, {}, "todos"],
    [:p, { class = "meta", id = "stats" }, "" .. completed .. " done of " .. created],
    [:div, { class = "row" },
      [:input, { id = "draft", placeholder = "what needs doing?" }],
      [:button, { id = "add", onclick = fn(e) { add_from_form(); } }, "add"]
    ],
    todo_view(items)
  ];
}

fn add_from_form() {
  let text = dom.get("#draft");
  if text != "" {
    add_todo(text);
  }
}

// Writers append and return. The panel wakes itself — the write path
// carries no render, no snapshot, no cast.
fn add_todo(text) {
  server!();
  store.append({ type = "add", text = text });
}

fn toggle_todo(id) {
  server!();
  store.append({ type = "toggle", id = id });
}

// The panel: show the board, wait until it changes, show it again. One
// live panel per tab, asleep in store.wait while the board is quiet.
fn todo_panel() {
  server!();
  while true {
    let snapshot = store.items(["todos"]);
    let created = store(["stats", "created"]);
    let completed = store(["stats", "completed"]);
    browser!();
    hui.render("#app", todo_app(snapshot, created, completed));
    server!();
    store.wait(["todos"]);
  }
}

// One panel per tab, birthed named: a reconnect re-births the same key
// and atomically replaces the stale panel instead of double-opening.
fn open_board() {
  flow "board" todo_panel();
}

fn on_connect() {
  open_board();
}
