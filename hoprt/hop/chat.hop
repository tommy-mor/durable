// chat.hop — rooms of messages, one panel per tab, woken by the store.
//
// Nested path: rooms → record → messages list. A send is one ListPush
// under that prefix. Switching rooms re-births the tab's panel under one
// key — "which room am I in" is the argument of the running
// panel flow, not a hidden input and not a tape event.
//
//   cargo run -p hoprt --bin hopd -- hoprt/hop/chat.hop

schema {
  rooms: map<record {
    messages: list<leaf>
  }>
}

fn reduce(event) {
  match event {
    say { room, sid, text } => {
      store(["rooms", room, "messages", store.push({
        who = sid,
        text = text
      })]);
    }
  }
}

fn chat_view(room, rooms, messages) {
  let room_links = [];
  for i, r in rooms {
    let name = r;
    push(room_links, [:button, {
      class = "room",
      id = "room-" .. name,
      onclick = fn(e) { open_room(name); }
    }, name]);
  }
  let lines = [];
  if messages {
    for i, m in messages {
      push(lines, [:li, { class = "msg" },
        [:span, { class = "meta" }, m.who .. ": "],
        m.text
      ]);
    }
  }
  return [:div, {},
    [:h1, {}, "chat"],
    [:p, { class = "meta", id = "room-name" }, "room " .. room],
    [:div, { class = "row", id = "room-bar" }, room_links],
    [:div, { class = "row" },
      [:input, { id = "new-room", placeholder = "new room" }],
      [:button, { id = "open-room", onclick = fn(e) { open_typed_room(); } }, "open"]
    ],
    [:ul, { id = "messages" }, lines],
    [:div, { class = "row" },
      [:input, { id = "draft", placeholder = "message" }],
      [:button, { id = "send", onclick = fn(e) { say_in(room); } }, "send"]
    ]
  ];
}

fn room_names() {
  let entries = store(["rooms", store.entries]);
  let names = ["lobby"];
  if entries {
    for i, pair in entries {
      let n = pair[0];
      if n != "lobby" {
        push(names, n);
      }
    }
  }
  return names;
}

fn paint(room) {
  let rooms = room_names();
  let messages = store(["rooms", room, "messages"]);
  return { room = room, rooms = rooms, messages = messages };
}

// The panel: show the room, wait until it changes, show it again. Still a
// story — nothing listens the code didn't name. One live panel per tab,
// asleep in store.wait while the room is quiet.
fn chat_panel(room) {
  server!();
  while true {
    let snap = paint(room);
    browser!();
    hui.render("#app", chat_view(snap.room, snap.rooms, snap.messages));
    server!();
    store.wait(["rooms", room, "messages"]);
  }
}

// Switching rooms re-births the tab's panel under the same key: the old
// room's panel dies whole (both halves, plus her store watch) as the new
// one starts. "Which room am I in" is the panel's argument — no hidden
// input, no tape event.
fn open_room(room) {
  flow "chat" chat_panel(room);
}

fn open_typed_room() {
  let name = dom.get("#new-room");
  if name == "" {
    return;
  }
  open_room(name);
}

// A send appends and returns. The room rides the button's closure — born
// inside the send button at render time — so no hidden input, no DOM
// scrape, no tab state outside the panel's own argument. The panel wakes
// itself: no broadcast, no refresh poke, no N round trips per write.
fn say_in(room) {
  let text = dom.get("#draft");
  if text == "" {
    return;
  }
  server!();
  store.append({ type = "say", sid = session(), room = room, text = text });
}

fn on_connect() {
  open_room("lobby");
}
