// guardian.hop — a play/pausable LLM guardian over a sorted index held by
// slug-as-a-database: the codebase indexer, one instance per repo. Pair
// selection and run state live here; every vote and the whole ranking
// live on slug via RPC (http effect) — ranking is never computed locally.
// LLM judgments stream live into the vote screen; humans can override
// with their own. File evidence comes through the rooted fs/git effects.
// Token usage from every judgment is folded into a billing projection —
// the invoice is computed from the tape, never from a payment processor.
//
//   SLUG: dev server at http://localhost:8080, room gt7dc9y/code-review.
//   cargo run -p hoprt --bin hopd -- hoprt/hop/guardian.hop \
//     --set slug_token=<dev-slug-token> \
//     --fs-root /Users/tommy/programming/slug-star/slug

schema {
  guardian: record {
    running: leaf,
    judging: leaf,
    judging_at: leaf,
    view: leaf,
    ticks: sum,
    err: leaf,
    prompt: leaf
  },
  files: map<record {
    url: leaf,
    lines: leaf
  }>,
  billing: record {
    prompt: sum,
    completion: sum,
    calls: sum
  },
  feed: list<leaf>
}

server let tick_every_ms = 800;
server let slug_url = "http://localhost:8080";
server let slug_room = "gt7dc9y/code-review";
server let slug_room_web = "gt7dc9ycode-review";
// the slug RPC bearer token — injected per deploy via `--set slug_token=...`;
// the dev-slug secret must never live in committed source.
server let slug_token = "";
server let slug_delegate = "99565dd4-6ce9-4aeb-8da5-7641317de958:eros:moonshotai/kimi-k3";
// the indexer tenancy: one hopd per repo — the scope in slug that holds
// this repo's votes and ranking, the URL base for member items, and the
// git pathspec that names the repo's big files
server let index_scope = "~code-review";
server let repo_url_base = "https://github.com/sortersocial/slug/blob/main/";
server let scan_pattern = "server/src/*.rs";

fn reduce(event) {
  match event {
    play {} => {
      store(["guardian", "running", store.set(true)]);
    }
    pause {} => {
      store(["guardian", "running", store.set(false)]);
    }
    tick_mark {} => {
      store(["guardian", "ticks", store.add(1)]);
    }
    file { path, url, lines } => {
      store(["files", path, store.set({ url = url, lines = lines })]);
    }
    judged { winner, loser, full } => {
      store(["feed", store.push("guardian: " .. winner .. " > " .. loser .. "\n" .. full)]);
    }
    judging { flag, at } => {
      store(["guardian", "judging", store.set(flag)]);
      store(["guardian", "judging_at", store.set(at)]);
    }
    view { mode } => {
      store(["guardian", "view", store.set(mode)]);
    }
    prompt { text } => {
      // The verbatim prompt for the latest judgment, kept durably. The
      // event log (log.jsonl) retains every prompt ever sent; the leaf
      // holds the latest for the fullscreen view.
      store(["guardian", "prompt", store.set(text)]);
    }
    manual { winner, loser } => {
      store(["feed", store.push("human: " .. winner .. " > " .. loser)]);
    }
    note { text } => {
      store(["feed", store.push("note: " .. text)]);
    }
    tokens { prompt, completion } => {
      // the invoice is a fold: every judgment's token accounting lands on
      // the tape and the sums below ARE the bill, recomputable from log
      store(["billing", "prompt", store.add(prompt)]);
      store(["billing", "completion", store.add(completion)]);
      store(["billing", "calls", store.add(1)]);
    }
    err { text } => {
      store(["guardian", "err", store.set(text)]);
    }
  }
}

// ---- slug (the database) ----

fn slug_rpc(cmd) {
  let res = http.post(slug_url .. "/api/v0/rpc", json.encode([cmd]), {
    Authorization = "Bearer " .. slug_token
  });
  if !res.ok {
    let msg = "slug rpc transport error";
    if res.error {
      msg = msg .. ": " .. res.error;
    }
    return { ok = false, err = msg };
  }
  if res.status >= 400 {
    return { ok = false, err = "slug rpc HTTP " .. res.status .. ": " .. res.body };
  }
  return { ok = true, data = json.decode(res.body) };
}

fn slug_post_vote(winner_url, loser_url, why) {
  let text = "{ " .. why .. " }\n" .. winner_url .. " 2:1 " .. loser_url .. "\n";
  return slug_rpc({
    Post = {
      room = slug_room,
      thread_tag = "judgments",
      delegate = slug_delegate,
      text = text
    }
  });
}

fn slug_rank_rows() {
  let rows = [];
  let res = slug_rpc({
    GetGardenRank = { room = slug_room, parent_path = index_scope }
  });
  if !res.ok {
    return rows;
  }
  // The RPC body wraps the batch in a map: { results: [ { ok, result: ... } ] }.
  let results = res.data.results;
  if !results || type(results) != "array" || len(results) == 0 {
    return rows;
  }
  if !results[0].ok {
    return rows;
  }
  let rank = results[0].result.GardenRank;
  if !rank || type(rank) != "map" {
    return rows;
  }
  // Rank centrality can split the vote graph into several components, each
  // with its own ranking — collect every one, not just the first.
  let comps = rank.components;
  if !comps || len(comps) == 0 {
    return rows;
  }
  for ci, comp in comps {
    let ranking = comp.ranking;
    if ranking {
      for i, r in ranking {
        push(rows, { item = r.item, score = r.score });
      }
    }
  }
  return rows;
}

// ---- helpers ----

fn rank_label(item, files) {
  if len(files) > 0 {
    for i, f in files {
      if str.has(item, f.url) {
        return f.id;
      }
    }
  }
  return item;
}

fn file_for_url(files, url) {
  if !url {
    return nil;
  }
  for i, f in files {
    if str.has(url, f.url) {
      return f;
    }
  }
  return nil;
}

// Pair choosing is ONE question asked of the database: slug's GetPair
// prefers unranked×ranked bridges first, then unvoted edges, so every
// vote connects the vote graph. There is no local fallback and no
// adoption — the scanner registers every big file, so a real scope member
// is always known here. A slug that cannot answer is an error to show; a
// suggested item no scanned file matches is foreign (possibly hostile)
// and is refused loudly — its text never becomes a path or reaches a
// shell.
fn next_pair(files) {
  let empty = { a = nil, b = nil };
  let res = slug_rpc({
    GetPair = { room = slug_room, parent_path = index_scope }
  });
  if !res.ok {
    if len(files) > 0 {
      store.append({ type = "err", text = res.err });
    }
    return empty;
  }
  let results = res.data.results;
  if !results || type(results) != "array" || len(results) == 0 {
    if len(files) > 0 {
      store.append({ type = "err", text = "slug GetPair: malformed rpc body" });
    }
    return empty;
  }
  if !results[0].ok {
    // Before the first scan the scope simply doesn't exist yet — the idle
    // state, not an error. Once files are registered a refusal is a wound
    // and gets shown.
    if len(files) > 0 {
      store.append({ type = "err", text = "slug GetPair refused the scope" });
    }
    return empty;
  }
  let pair = results[0].result.Pair;
  if !pair || type(pair) != "map" {
    if len(files) > 0 {
      store.append({ type = "err", text = "slug GetPair: no pair in response" });
    }
    return empty;
  }
  let a = file_for_url(files, pair.left);
  if !a {
    store.append({ type = "note", text = "refused unknown slug-suggested item: " .. pair.left });
    return empty;
  }
  let b = file_for_url(files, pair.right);
  if !b {
    store.append({ type = "note", text = "refused unknown slug-suggested item: " .. pair.right });
    return empty;
  }
  return { a = a, b = b };
}

fn judge_prompt(a, b, bodies) {
  return "You are a code-health guardian. Judge which of these two source files MOST needs refactoring, using the actual file contents below as evidence (responsibilities, coupling, cohesion, size).\n\n"
    .. "a: " .. a.id .. " — " .. a.lines .. " lines\n"
    .. "b: " .. b.id .. " — " .. b.lines .. " lines\n\n"
    .. bodies .. "\n\n"
    .. "Give one short paragraph of reasoning that cites concrete details from the file contents, then a final line that is ONLY this JSON: {\"winner\":\"a\",\"why\":\"one sentence\"} or {\"winner\":\"b\",\"why\":\"one sentence\"}.";
}

// ---- view ----

fn view_css() {
  return ".guardian-grid { display: flex; gap: 18px; align-items: flex-start; } "
    .. ".vote-col { flex: 1.2; min-width: 0; } "
    .. ".log-col { flex: 1; min-width: 0; } "
    .. ".log-page { display: flex; flex-direction: column; height: 100vh; margin: 0; } "
    .. ".log-topbar { padding: 8px 12px; border-bottom: 1px solid #ccc; background: white; } "
    .. ".log-pane { flex: 1; overflow-y: auto; padding: 10px; background: #fafafa; } "
    .. ".judge-log { max-height: 62vh; overflow-y: auto; border: 1px solid #ccc; padding: 8px; background: #fafafa; } "
    .. ".judge-entry { white-space: pre-wrap; font-family: monospace; font-size: 12px; margin: 0 0 8px; padding: 6px; border-bottom: 1px solid #eee; } "
    .. ".prompt-pre { white-space: pre-wrap; font-family: monospace; font-size: 12px; margin: 0; padding: 8px; background: #fff; border: 1px solid #e5e5e5; } "
    .. ".stream-entry { background: #fff8d6; border: 1px solid #e0cf7a; } "
    .. ".pair-card { border: 1px solid #bbb; padding: 10px; flex: 1; background: white; } "
    .. ".vote-row { display: flex; gap: 12px; align-items: stretch; margin-bottom: 14px; } "
    .. ".vs { align-self: center; font-weight: bold; } "
    .. ".chart-svg { width: 100%; height: auto; border: 1px solid #ddd; background: #fff; } "
    .. ".chart-frame { width: 100%; height: 440px; border: 1px solid #ddd; background: #fff; } "
    .. ".err { color: #a00; } "
    .. ".mono { font-family: monospace; font-size: 12px; } "
    .. ".num { text-align: right; font-family: monospace; } "
    .. "table.rank { border-collapse: collapse; width: 100%; } "
    .. "table.rank td { border-top: 1px solid #eee; padding: 2px 6px; font-size: 13px; }";
}

// The graph is slug's graph — an iframe into the database's own replay view
// (?v=history), not a local copy of its data. The iframe rides hopd's authed
// /r/ proxy (same origin, bearer injected server-side by hopd). The URLs are
// computed SERVER-side (fn graph_urls) and passed in: server lets like
// slug_url and slug_room_web don't exist in the browser VM, where app_view
// actually renders. It sits in a native <details>, collapsed by default with
// loading="lazy": the first paint carries no iframe weight at all, and the
// replay appears exactly when someone asks for it. Butter.
fn chart_block(graph) {
  return [:details, { class = "chart" },
    [:summary, {}, "score history · slug's own graph"],
    [:iframe, { src = graph.src, class = "chart-frame", title = "slug score history", loading = "lazy" }],
    [:p, { class = "meta" },
      [:a, { href = graph.href, target = "_blank" }, "open the replay in slug →"]
    ]
  ];
}

fn graph_urls() {
  return {
    src = "/r/" .. slug_room_web .. "/~/code-review?v=history",
    href = slug_url .. "/r/" .. slug_room_web .. "/~/code-review?v=history"
  };
}

fn pair_card(file, side) {
  let cls = "pair-card pair-" .. side;
  if !file {
    return [:div, { class = cls }, [:p, { class = "muted" }, "…"]];
  }
  return [:div, { class = cls },
    [:h3, {}, side],
    [:p, { class = "mono" }, file.id],
    [:p, { class = "muted" }, file.lines .. " lines"],
    [:button, {
      class = "pick",
      onclick = fn(e) {
        server!();
        manual_pick(side);
      }
    }, side .. " wins"]
  ];
}

// The wire carries only the newest 40 feed entries, never the whole tape.
// `feed_tail` is the SERVER half: it slices the already-materialized feed
// (pushed oldest-first) down to the last 40 strings, newest first, so the
// cast ships a bounded payload no matter how far the tape has grown. The
// full record stays in the durable store and log — an unbounded feed
// shipped on every paint made the websocket megabytes, and reconnects ate
// the clicks.
fn feed_tail(feed) {
  let out = [];
  let n = len(feed);
  let start = n - 40;
  if start < 0 {
    start = 0;
  }
  let k = n - 1;
  while k >= start {
    push(out, feed[k]);
    k = k - 1;
  }
  return out;
}

// The BROWSER half of the same split: wrap the already-trimmed tail in
// hiccup. Slice on the server, render in the tab — the same division as
// graph_urls / chart_block. The live "guardian thinking" entry is built by
// the caller and prepended ahead of these rows.
fn entries_view(entries) {
  let rows = [];
  for i, e in entries {
    push(rows, [:pre, { class = "judge-entry" }, e]);
  }
  return rows;
}

// The fullscreen agent tail: back button on top, the entire lower pane is
// the live judgment log.
fn log_view(status, entries, stream_a, stream_b, stream_text, err) {
  let rows = entries_view(entries);
  let live = [];
  if stream_text != "" {
    push(live, [:pre, { class = "judge-entry stream-entry" },
      "guardian thinking: " .. stream_a .. " vs " .. stream_b .. "\n" .. stream_text
    ]);
  }
  let parts = [];
  push(parts, [:style, {}, view_css()]);
  push(parts, [:div, { class = "log-topbar" },
    [:button, { onclick = fn(e) { set_view("normal"); } }, "← back"],
    " · ",
    status
  ]);
  if err {
    push(parts, [:p, { class = "err" }, err]);
  }
  push(parts, [:div, { class = "log-pane" }, live, rows]);
  return [:div, { class = "log-page" }, parts];
}

// The fullscreen verbatim prompt: exactly what the model saw for the latest
// judgment — heads, bodies, truncation markers, all of it. Every historical
// prompt lives in the durable log (log.jsonl); the view shows the latest.
// The text is fetched SERVER-side and passed in — the store doesn't exist
// in the browser VM where views render.
fn prompt_view(prompt_text, status) {
  let parts = [];
  push(parts, [:style, {}, view_css()]);
  push(parts, [:div, { class = "log-topbar" },
    [:button, { onclick = fn(e) { set_view("normal"); } }, "← back"],
    " · ",
    status,
    " · verbatim prompt sent to the model (latest; every prompt is in the durable log)"
  ]);
  if prompt_text {
    push(parts, [:div, { class = "log-pane" }, [:pre, { class = "prompt-pre" }, prompt_text]]);
  } else {
    push(parts, [:div, { class = "log-pane" },
      [:p, { class = "muted" }, "no prompt recorded yet — run a judgment first"]
    ]);
  }
  return [:div, { class = "log-page" }, parts];
}

fn app_view(status, files, rank_rows, entries, stream_a, stream_b, stream_text, err, graph, prompt_text, pair, view) {
  if view == "log" {
    return log_view(status, entries, stream_a, stream_b, stream_text, err);
  }
  if view == "prompt" {
    return prompt_view(prompt_text, status);
  }
  let parts = [];
  push(parts, [:style, {}, view_css()]);
  push(parts, [:h1, {}, "guardian"]);
  push(parts, [:p, { class = "meta" },
    status,
    " · ",
    [:button, { onclick = fn(e) { set_view("log"); } }, "⤢ log"],
    [:button, { onclick = fn(e) { set_view("prompt"); } }, "⤢ prompt"]
  ]);
  if err {
    push(parts, [:p, { class = "err" }, err]);
  }
  push(parts, [:div, { class = "row" },
    [:button, { onclick = fn(e) { play(); } }, "play"],
    [:button, { onclick = fn(e) { pause(); } }, "pause"],
    [:button, { onclick = fn(e) { scan_repo(); } }, "scan repo"]
  ]);

  let vote_col = [];
  push(vote_col, [:h2, {}, "vote screen"]);
  // pair is computed server-side (slug's GetPair suggestion) and passed in —
  // the store and RPC don't exist in this VM.
  push(vote_col, [:div, { class = "vote-row" },
    (pair_card(pair.a, "a")),
    [:div, { class = "vs" }, "vs"],
    (pair_card(pair.b, "b"))
  ]);
  push(vote_col, (chart_block(graph)));
  push(vote_col, [:h2, {}, "slug ranking (the database)"]);
  let rank_rows_view = [];
  for i, r in rank_rows {
    push(rank_rows_view, [:tr, {},
      [:td, { class = "mono" }, rank_label(r.item, files)],
      [:td, { class = "num" }, "" .. r.score]
    ]);
  }
  push(vote_col, [:table, { class = "rank" },
    [:tr, {}, [:th, {}, "file"], [:th, {}, "score"]],
    rank_rows_view
  ]);

  let log_col = [];
  push(log_col, [:h2, {}, "judgment log"]);
  let rows = entries_view(entries);
  let live = [];
  if stream_text != "" {
    push(live, [:pre, { class = "judge-entry stream-entry" },
      "guardian thinking: " .. stream_a .. " vs " .. stream_b .. "\n" .. stream_text
    ]);
  }
  push(log_col, [:div, { class = "judge-log" }, live, rows]);

  push(parts, [:div, { class = "guardian-grid" },
    [:div, { class = "vote-col" }, vote_col],
    [:div, { class = "log-col" }, log_col]
  ]);
  return [:div, {}, parts];
}

// The running invoice, folded from the tape: tokens in, tokens out, and
// how many judgments the meter has seen. Recomputable from log.jsonl.
fn billing_line() {
  let p = store(["billing", "prompt"]);
  let c = store(["billing", "completion"]);
  let n = store(["billing", "calls"]);
  return "⚡ " .. p .. " in / " .. c .. " out · " .. n .. " calls";
}

fn paint(stream_a, stream_b, stream_text) {
  let files = store.items(["files"]);
  let ticks = store(["guardian", "ticks"]);
  let feed = store(["feed"]);
  if !feed {
    feed = [];
  }
  let entries = feed_tail(feed);
  let err = store(["guardian", "err"]);
  let state = "⏸ paused";
  if store(["guardian", "running"]) {
    state = "● running";
  }
  let status = state .. " · tick " .. ticks .. " · " .. billing_line();
  let rank_rows = slug_rank_rows();
  let graph = graph_urls();
  let prompt_text = store(["guardian", "prompt"]);
  let pair = next_pair(files);
  let view = store(["guardian", "view"]);
  cast browsers {
    hui.render("#app", app_view(status, files, rank_rows, entries, stream_a, stream_b, stream_text, err, graph, prompt_text, pair, view));
  }
}

// ---- flows ----

fn play() {
  server!();
  store.append({ type = "play" });
  paint("", "", "");
}

fn pause() {
  server!();
  store.append({ type = "pause" });
  paint("", "", "");
}

fn set_view(mode) {
  server!();
  store.append({ type = "view", mode = mode });
  paint("", "", "");
}

fn scan_repo() {
  server!();
  // Tracked files straight from git, line counts straight from fs — the
  // rooted effects do what the old Python scanner did, with no shell and
  // no sidecar. Every file over 400 lines registers: no top-N cut, so
  // slug's GetPair never suggests a member this store hasn't met.
  let res = git.files(scan_pattern);
  if !res.ok {
    store.append({ type = "err", text = "scan failed: " .. res.error });
    paint("", "", "");
    return;
  }
  let rows = [];
  for i, path in res.files {
    let c = fs.count_lines(path);
    if c.ok && c.lines > 400 {
      push(rows, { path = path, lines = c.lines });
    }
  }
  if len(rows) == 0 {
    store.append({ type = "err", text = "scan produced no files" });
    paint("", "", "");
    return;
  }
  let base = repo_url_base;
  let doc = index_scope .. " { the codebase, judged file by file }\n";
  for i, r in rows {
    store.append({ type = "file", path = r.path, url = base .. r.path, lines = r.lines });
    doc = doc .. base .. r.path .. " { " .. r.path .. " — " .. r.lines .. " lines }\n";
  }
  // Plant the claims that make each file a MEMBER of the ranked scope. The
  // item lines alone are not enough: without `<: ~code-review` the file
  // votes as a ghost — its vote lands in the global graph but the scope's
  // rank table and the database's own garden never see it.
  for i, r in rows {
    doc = doc .. "{ part of the codebase }\n" .. base .. r.path .. " <: " .. index_scope .. "\n";
  }
  let reg = slug_rpc({
    Post = {
      room = slug_room,
      thread_tag = "files",
      delegate = slug_delegate,
      text = doc
    }
  });
  if !reg.ok {
    store.append({ type = "err", text = "slug registration failed: " .. reg.err });
  }
  store.append({ type = "note", text = "scanned repo: files registered" });
  paint("", "", "");
}

fn manual_pick(side) {
  let files = store.items(["files"]);
  if len(files) == 0 {
    paint("", "", "");
    return;
  }
  // the human's override lands on the suggested pair — same bridge-building
  // rule as the automatic loop
  let pair = next_pair(files);
  if !pair.a || !pair.b {
    paint("", "", "");
    return;
  }
  let w = pair.a;
  let l = pair.b;
  if side == "b" {
    w = pair.b;
    l = pair.a;
  }
  let res = slug_post_vote(w.url, l.url, "manual review by human");
  if !res.ok {
    store.append({ type = "err", text = res.err });
  } else {
    store.append({ type = "manual", winner = w.id, loser = l.id });
  }
  paint("", "", "");
}

// Fired by hopd's scheduler (every 800ms). The judging flag makes the loop
// sequential with no overlap and no downtime: while a judgment is in flight
// ticks return instantly; the moment it lands, the next one can start.
fn tick() {
  if !store(["guardian", "running"]) {
    return;
  }
  // Watchdog: a judging flag older than two minutes means the judgment
  // flow died mid-flight (hung effect, hard error) — recover and move on.
  if store(["guardian", "judging"]) {
    let at = store(["guardian", "judging_at"]);
    if at {
      if time.now() - at < 120000 {
        return;
      }
    }
  }
  let files = store.items(["files"]);
  if len(files) == 0 {
    return;
  }
  let pair = next_pair(files);
  if !pair.a || !pair.b {
    return;
  }
  store.append({ type = "judging", flag = true, at = time.now() });
  store.append({ type = "tick_mark" });
  // The real evidence: both files' FULL contents through the rooted fs
  // effect — hopd refuses anything outside --fs-root in Rust, so no
  // app-side path gate and no shell ever enter the judging loop.
  let ra = fs.read(pair.a.id);
  if !ra.ok {
    store.append({ type = "err", text = "body read failed: " .. ra.error });
    store.append({ type = "judging", flag = false, at = nil });
    paint("", "", "");
    return;
  }
  let rb = fs.read(pair.b.id);
  if !rb.ok {
    store.append({ type = "err", text = "body read failed: " .. rb.error });
    store.append({ type = "judging", flag = false, at = nil });
    paint("", "", "");
    return;
  }
  let bodies = "===== FILE a: " .. pair.a.id .. " =====\n" .. ra.text
    .. "\n\n===== FILE b: " .. pair.b.id .. " =====\n" .. rb.text;
  let prompt = judge_prompt(pair.a, pair.b, bodies);
  store.append({ type = "prompt", text = prompt });
  let ticks = store(["guardian", "ticks"]);
  let feed = store(["feed"]);
  if !feed {
    feed = [];
  }
  let entries = feed_tail(feed);
  let status = "● running · tick " .. ticks .. " · " .. billing_line();
  let rank_rows = slug_rank_rows();
  let graph = graph_urls();
  let prompt_text = store(["guardian", "prompt"]);
  let h = llm.stream({ messages = [{ role = "user", content = prompt }] });
  let acc = "";
  let out = llm.next(h);
  while out.delta {
    acc = acc .. out.delta;
    let view = store(["guardian", "view"]);
    cast browsers {
      hui.render("#app", app_view(status, files, rank_rows, entries, pair.a.id, pair.b.id, acc, nil, graph, prompt_text, pair, view));
    }
    // Heartbeat: keep judging_at fresh while a judgment is actually
    // streaming. The watchdog reaps at 120s of silence — but bodies are
    // uncapped, a 40k-token judgment can legitimately exceed that wall
    // clock, and reaping mid-stream breeds a second concurrent LLM call on
    // the same store. Touch at most every 30s so the log doesn't drown.
    let last_at = store(["guardian", "judging_at"]);
    if !last_at || time.now() - last_at > 30000 {
      store.append({ type = "judging", flag = true, at = time.now() });
    }
    out = llm.next(h);
  }
  if out.usage {
    store.append({ type = "tokens", prompt = out.usage.prompt_tokens, completion = out.usage.completion_tokens });
  }
  if out.error {
    store.append({ type = "err", text = "llm: " .. out.error });
    store.append({ type = "judging", flag = false, at = nil });
    paint("", "", "");
    return;
  }
  let verdict = json.first(out.text);
  // json.first fishes the FIRST JSON object anywhere in the stream, so a
  // stray `{...}` in the reasoning (a quoted snippet, an example) parses
  // cleanly and the old code then silently voted for "a". A verdict is a
  // verdict only when it names a real side AND carries a non-empty reason —
  // anything else is foreign and is refused loudly, like a foreign item:
  // never a silent default, never a vote cast on garbage.
  let ok = type(verdict) == "map" && (verdict.winner == "a" || verdict.winner == "b") && type(verdict.why) == "string" && verdict.why != "";
  if !ok {
    store.append({ type = "err", text = "guardian refused a malformed verdict (no winner or why)" });
    store.append({ type = "judging", flag = false, at = nil });
    paint("", "", "");
    return;
  }
  let w = pair.a;
  let l = pair.b;
  if verdict.winner == "b" {
    w = pair.b;
    l = pair.a;
  }
  let res = slug_post_vote(w.url, l.url, verdict.why);
  if !res.ok {
    store.append({ type = "err", text = res.err });
  } else {
    store.append({ type = "judged", winner = w.id, loser = l.id, full = out.text });
    // a judgment that lands clears the wound display: stale errors (e.g.
    // the scope not existing before the first scan) must not outlive health
    store.append({ type = "err", text = nil });
  }
  store.append({ type = "judging", flag = false, at = nil });
  paint("", "", "");
}

fn on_connect(sid) {
  paint("", "", "");
}
