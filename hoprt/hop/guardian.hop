// guardian.hop — a play/pausable LLM guardian over a sorted index held by
// slug-as-a-database. Pair selection and run state live here; every vote
// and the whole ranking live on slug via RPC (http effect). LLM judgments
// stream live into the vote screen; humans can override with their own.
//
//   SLUG: dev server at http://localhost:8080, room gt7dc9y/code-review.
//   cargo run -p hoprt --bin hopd -- hoprt/hop/guardian.hop

server let schema = store.record([
  ["guardian", store.record([
    ["running", store.leaf],
    ["judging", store.leaf],
    ["ticks", store.sum],
    ["err", store.leaf]
  ])],
  ["files", store.map(store.record([
    ["url", store.leaf],
    ["lines", store.leaf],
    ["judged", store.sum]
  ]))],
  ["feed", store.list(store.leaf)]
]);

server let tick_every_ms = 800;
server let slug_url = "http://localhost:8080";
server let slug_room = "gt7dc9y/code-review";
server let slug_room_web = "gt7dc9ycode-review";
server let slug_token = "slug_erosdev_erosdevsecret";
server let slug_delegate = "99565dd4-6ce9-4aeb-8da5-7641317de958:eros:moonshotai/kimi-k3";
server let repo_scanner = "python3 /Users/tommy/eros/scan_slug_repo.py";

fn reduce(event) {
  match event {
    play {} => {
      store(["guardian", "running", store.set(true)]);
    }
    pause {} => {
      store(["guardian", "running", store.set(false)]);
    }
    tick_mark {} => {
      store(["guardian", "ticks", store.add(1)]);
    }
    file { path, url, lines } => {
      store(["files", path, store.set({ url = url, lines = lines, judged = 0 })]);
    }
    judged { winner, loser, full } => {
      store(["files", winner, "judged", store.add(1)]);
      store(["files", loser, "judged", store.add(1)]);
      store(["feed", store.push("guardian: " .. winner .. " > " .. loser .. "\n" .. full)]);
    }
    judging { flag } => {
      store(["guardian", "judging", store.set(flag)]);
    }
    manual { winner, loser } => {
      store(["files", winner, "judged", store.add(1)]);
      store(["files", loser, "judged", store.add(1)]);
      store(["feed", store.push("human: " .. winner .. " > " .. loser)]);
    }
    note { text } => {
      store(["feed", store.push("note: " .. text)]);
    }
    err { text } => {
      store(["guardian", "err", store.set(text)]);
    }
  }
}

// ---- slug (the database) ----

fn slug_rpc(cmd) {
  let res = http.post(slug_url .. "/api/v0/rpc", json.encode([cmd]), {
    Authorization = "Bearer " .. slug_token
  });
  if !res.ok {
    let msg = "slug rpc transport error";
    if res.error {
      msg = msg .. ": " .. res.error;
    }
    return { ok = false, err = msg };
  }
  if res.status >= 400 {
    return { ok = false, err = "slug rpc HTTP " .. res.status .. ": " .. res.body };
  }
  return { ok = true, data = json.decode(res.body) };
}

fn slug_post_vote(winner_url, loser_url, why) {
  let text = "{ " .. why .. " }\n" .. winner_url .. " 2:1 " .. loser_url .. "\n";
  return slug_rpc({
    Post = {
      room = slug_room,
      thread_tag = "judgments",
      delegate = slug_delegate,
      text = text
    }
  });
}

fn slug_rank_rows() {
  let rows = [];
  let res = slug_rpc({
    GetGardenRank = { room = slug_room, parent_path = "~code-review" }
  });
  if res.ok {
    if type(res.data) == "array" {
      if len(res.data) > 0 {
        let rank = res.data[0].result.GardenRank;
        if type(rank) == "map" {
          let comps = rank.components;
          if comps && len(comps) > 0 {
            let ranking = comps[0].ranking;
            if ranking {
              for i, r in ranking {
                push(rows, { item = r.item, score = r.score });
              }
            }
          }
        }
      }
    }
  }
  return rows;
}

// The replay endpoint (?v=history.json) — slug's own score history over
// every vote event. Rendered here as SVG; refreshed every paint, so the
// chart grows live as the guardian votes.
fn slug_history_series(files) {
  let url = slug_url .. "/r/" .. slug_room_web .. "/~/code-review?v=history.json";
  let res = http.get(url, { Authorization = "Bearer " .. slug_token });
  let series = [];
  let steps = 0;
  let y_max = 0.001;
  if res.ok {
    let d = json.decode(res.body);
    if type(d) == "map" {
      let hist = d.history;
      if hist && type(hist) == "array" {
        steps = len(hist);
        let n_files = 0;
        if files {
          for i, f in files {
            n_files = n_files + 1;
          }
        }
        // pass 1: collect raw series (x by step index, score), find max
        let raw = [];
        let idx = 0;
        for i, f in files {
          let pts = [];
          let xi = 0;
          for j, step in hist {
            let rs = step.current_rankings;
            if rs {
              for k, r in rs {
                if str.has(r.item, f.url) {
                  let x = 30 + xi * (560 / (steps - 1));
                  if steps == 1 {
                    x = 30;
                  }
                  push(pts, { x = x, s = r.score });
                  if r.score > y_max {
                    y_max = r.score;
                  }
                  xi = xi + 1;
                }
              }
            }
          }
          if len(pts) > 0 {
            let hue = (idx * 360) / n_files;
            push(raw, { label = f.id, color = "hsl(" .. hue .. ", 70%, 50%)", pts = pts });
          }
          idx = idx + 1;
        }
        // pass 2: scale scores to y with the final max
        for i, s in raw {
          let out_pts = [];
          for j, p in s.pts {
            push(out_pts, { x = p.x, y = 205 - (p.s / y_max) * 190 });
          }
          push(series, { label = s.label, color = s.color, pts = out_pts });
        }
      }
    }
  }
  return { series = series, steps = steps, y_max = y_max };
}

// ---- helpers ----

fn rank_label(item, files) {
  if files {
    for i, f in files {
      if str.has(item, f.url) {
        return f.id;
      }
    }
  }
  return item;
}

fn pick_pair(files) {
  let a = false;
  let b = false;
  for i, f in files {
    if !a {
      b = a;
      a = f;
    } else {
      if f.judged < a.judged {
        b = a;
        a = f;
      } else {
        if !b {
          b = f;
        } else {
          if f.judged < b.judged {
            b = f;
          }
        }
      }
    }
  }
  return { a = a, b = b };
}

fn judge_prompt(a, b) {
  return "You are a code-health guardian. Judge which of these two source files MOST needs refactoring, using the path and size as evidence (responsibility implied by the path; larger files with broad names are usually worse offenders).\n\n"
    .. "a: " .. a.id .. " — " .. a.lines .. " lines\n"
    .. "b: " .. b.id .. " — " .. b.lines .. " lines\n\n"
    .. "Give one short paragraph of reasoning, then a final line that is ONLY this JSON: {\"winner\":\"a\",\"why\":\"one sentence\"} or {\"winner\":\"b\",\"why\":\"one sentence\"}.";
}

// ---- view ----

fn arr_len(a) {
  let n = 0;
  for i, x in a {
    n = n + 1;
  }
  return n;
}

fn view_css() {
  return ".guardian-grid { display: flex; gap: 18px; align-items: flex-start; } "
    .. ".vote-col { flex: 1.2; min-width: 0; } "
    .. ".log-col { flex: 1; min-width: 0; } "
    .. ".judge-log { max-height: 62vh; overflow-y: auto; border: 1px solid #ccc; padding: 8px; background: #fafafa; } "
    .. ".judge-entry { white-space: pre-wrap; font-family: monospace; font-size: 12px; margin: 0 0 8px; padding: 6px; border-bottom: 1px solid #eee; } "
    .. ".stream-entry { background: #fff8d6; border: 1px solid #e0cf7a; } "
    .. ".pair-card { border: 1px solid #bbb; padding: 10px; flex: 1; background: white; } "
    .. ".vote-row { display: flex; gap: 12px; align-items: stretch; margin-bottom: 14px; } "
    .. ".vs { align-self: center; font-weight: bold; } "
    .. ".chart-svg { width: 100%; height: auto; border: 1px solid #ddd; background: #fff; } "
    .. ".err { color: #a00; } "
    .. ".mono { font-family: monospace; font-size: 12px; } "
    .. ".num { text-align: right; font-family: monospace; } "
    .. "table.rank { border-collapse: collapse; width: 100%; } "
    .. "table.rank td { border-top: 1px solid #eee; padding: 2px 6px; font-size: 13px; }";
}

fn chart_block(chart) {
  let els = [];
  for i, s in chart.series {
    let d = "";
    let first = true;
    for j, p in s.pts {
      if first {
        d = "M " .. p.x .. " " .. p.y;
        first = false;
      } else {
        d = d .. " L " .. p.x .. " " .. p.y;
      }
    }
    push(els, [:path, { d = d, style = "fill:none;stroke-width:2;stroke:" .. s.color }, ""]);
    let lastx = 0;
    let lasty = 0;
    for j, p in s.pts {
      lastx = p.x;
      lasty = p.y;
    }
    push(els, [:circle, { cx = lastx, cy = lasty, r = "3", style = "fill:" .. s.color }, ""]);
  }
  let caption = "score history · " .. chart.steps .. " vote events · live from slug";
  return [:div, { class = "chart" },
    [:h3, {}, caption],
    [:svg, { viewBox = "0 0 620 220", class = "chart-svg" }, els]
  ];
}

fn pair_card(file, side) {
  let cls = "pair-card pair-" .. side;
  if !file {
    return [:div, { class = cls }, [:p, { class = "muted" }, "…"]];
  }
  return [:div, { class = cls },
    [:h3, {}, side],
    [:p, { class = "mono" }, file.id],
    [:p, { class = "muted" }, file.lines .. " lines"],
    [:button, {
      class = "pick",
      onclick = fn(e) {
        server!();
        manual_pick(side);
      }
    }, side .. " wins"]
  ];
}

fn app_view(status, files, rank_rows, feed, stream_a, stream_b, stream_text, err, chart) {
  let parts = [];
  push(parts, [:style, {}, view_css()]);
  push(parts, [:h1, {}, "guardian"]);
  push(parts, [:p, { class = "meta" }, status]);
  if err {
    push(parts, [:p, { class = "err" }, err]);
  }
  push(parts, [:div, { class = "row" },
    [:button, { onclick = fn(e) { play(); } }, "play"],
    [:button, { onclick = fn(e) { pause(); } }, "pause"],
    [:button, { onclick = fn(e) { scan_repo(); } }, "scan repo"]
  ]);

  let vote_col = [];
  push(vote_col, [:h2, {}, "vote screen"]);
  let pair = pick_pair(files);
  push(vote_col, [:div, { class = "vote-row" },
    (pair_card(pair.a, "a")),
    [:div, { class = "vs" }, "vs"],
    (pair_card(pair.b, "b"))
  ]);
  push(vote_col, (chart_block(chart)));
  push(vote_col, [:h2, {}, "slug ranking (the database)"]);
  let rank_rows_view = [];
  for i, r in rank_rows {
    push(rank_rows_view, [:tr, {},
      [:td, { class = "mono" }, rank_label(r.item, files)],
      [:td, { class = "num" }, "" .. r.score]
    ]);
  }
  push(vote_col, [:table, { class = "rank" },
    [:tr, {}, [:th, {}, "file"], [:th, {}, "score"]],
    rank_rows_view
  ]);

  let log_col = [];
  push(log_col, [:h2, {}, "judgment log"]);
  let entries = [];
  if feed {
    for i, j in feed {
      push(entries, [:pre, { class = "judge-entry" }, j]);
    }
  }
  if stream_text != "" {
    push(entries, [:pre, { class = "judge-entry stream-entry" },
      "guardian thinking: " .. stream_a .. " vs " .. stream_b .. "\n" .. stream_text
    ]);
  }
  push(entries, [:a, { id = "latest" }, ""]);
  push(log_col, [:div, { class = "judge-log" }, entries]);
  push(log_col, [:p, {}, [:a, { href = "#latest" }, "↓ latest"]]);

  push(parts, [:div, { class = "guardian-grid" },
    [:div, { class = "vote-col" }, vote_col],
    [:div, { class = "log-col" }, log_col]
  ]);
  return [:div, {}, parts];
}

fn paint(stream_a, stream_b, stream_text) {
  let files = store.items(["files"]);
  let ticks = store(["guardian", "ticks"]);
  if !ticks {
    ticks = 0;
  }
  let feed = store(["feed"]);
  if !feed {
    feed = [];
  }
  let err = store(["guardian", "err"]);
  let status = "⏸ paused · tick " .. ticks;
  if store(["guardian", "running"]) {
    status = "● running · tick " .. ticks;
  }
  let rank_rows = slug_rank_rows();
  let chart = slug_history_series(files);
  cast browsers {
    hui.render("#app", app_view(status, files, rank_rows, feed, stream_a, stream_b, stream_text, err, chart));
  }
}

// ---- flows ----

fn play() {
  server!();
  store.append({ type = "play" });
  paint("", "", "");
}

fn pause() {
  server!();
  store.append({ type = "pause" });
  paint("", "", "");
}

fn scan_repo() {
  server!();
  let out = bash(repo_scanner);
  if !out.ok {
    store.append({ type = "err", text = "scan failed: " .. out.stderr });
    paint("", "", "");
    return;
  }
  let rows = json.decode(out.stdout);
  if type(rows) != "array" {
    store.append({ type = "err", text = "scan produced no files" });
    paint("", "", "");
    return;
  }
  let base = "https://github.com/sortersocial/slug/blob/main/";
  for i, r in rows {
    store.append({ type = "file", path = r.path, url = base .. r.path, lines = r.lines });
  }
  store.append({ type = "note", text = "scanned repo: files registered" });
  paint("", "", "");
}

fn manual_pick(side) {
  let files = store.items(["files"]);
  if !files {
    paint("", "", "");
    return;
  }
  let pair = pick_pair(files);
  if !pair.a || !pair.b {
    paint("", "", "");
    return;
  }
  let w = pair.a;
  let l = pair.b;
  if side == "b" {
    w = pair.b;
    l = pair.a;
  }
  let res = slug_post_vote(w.url, l.url, "manual review by human");
  if !res.ok {
    store.append({ type = "err", text = res.err });
  } else {
    store.append({ type = "manual", winner = w.id, loser = l.id });
  }
  paint("", "", "");
}

// Fired by hopd's scheduler (every 800ms). The judging flag makes the loop
// sequential with no overlap and no downtime: while a judgment is in flight
// ticks return instantly; the moment it lands, the next one can start.
fn tick() {
  if !store(["guardian", "running"]) {
    return;
  }
  if store(["guardian", "judging"]) {
    return;
  }
  let files = store.items(["files"]);
  if !files {
    return;
  }
  let pair = pick_pair(files);
  if !pair.a || !pair.b {
    return;
  }
  store.append({ type = "judging", flag = true });
  store.append({ type = "tick_mark" });
  let prompt = judge_prompt(pair.a, pair.b);
  let ticks = store(["guardian", "ticks"]);
  if !ticks {
    ticks = 0;
  }
  let feed = store(["feed"]);
  if !feed {
    feed = [];
  }
  let status = "● running · tick " .. ticks;
  let rank_rows = slug_rank_rows();
  let chart = slug_history_series(files);
  let h = llm.stream({ messages = [{ role = "user", content = prompt }] });
  let acc = "";
  let out = llm.next(h);
  while out.delta {
    acc = acc .. out.delta;
    cast browsers {
      hui.render("#app", app_view(status, files, rank_rows, feed, pair.a.id, pair.b.id, acc, nil, chart));
    }
    out = llm.next(h);
  }
  if out.error {
    store.append({ type = "err", text = "llm: " .. out.error });
    store.append({ type = "judging", flag = false });
    paint("", "", "");
    return;
  }
  let verdict = json.first(out.text);
  if type(verdict) != "map" {
    store.append({ type = "err", text = "guardian could not parse a verdict" });
    store.append({ type = "judging", flag = false });
    paint("", "", "");
    return;
  }
  let w = pair.a;
  let l = pair.b;
  if verdict.winner == "b" {
    w = pair.b;
    l = pair.a;
  }
  let res = slug_post_vote(w.url, l.url, verdict.why);
  if !res.ok {
    store.append({ type = "err", text = res.err });
  } else {
    store.append({ type = "judged", winner = w.id, loser = l.id, full = out.text });
  }
  store.append({ type = "judging", flag = false });
  paint("", "", "");
}

fn on_connect(sid) {
  paint("", "", "");
}
