// ── presence ────────────────────────────────────────────────────────────

// hopd stamps the profile: display name and the admin bit (from the
// discord allowlist, or open when none is configured). Record it, land a
// first-time user in the lobby, paint.
fn on_connect(sid, uid, profile) {
  let name = "";
  let admin = false;
  if profile {
    if profile.name {
      name = profile.name;
    }
    admin = profile.admin == true;
  }
  let known = store(["users", uid]);
  if !known || known.name != name || known.admin != admin {
    store.append({ type = "seen", uid = uid, name = name, admin = admin });
  }
  if !store(["views", uid]) {
    store.append({ type = "view", uid = uid, tid = "lobby" });
  }
  paint_user(uid);
}
